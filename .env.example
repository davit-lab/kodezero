# Public browser configuration for email accounts and private progress sync.
# Never set a service-role or sb_secret key in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Server-only AI provider key. Set in Vercel Project Settings > Environment Variables.
# Choose one. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
